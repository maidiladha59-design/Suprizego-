    "shadow": "rgb(17, 17, 17) 4px 4px 0px 0px",
    "radius": "12px",
    "border": "3px solid rgb(17, 17, 17)",
    "padding": "8px 16px",
    "font": "\"Archivo Black\", \"Archivo Black Fallback\", \"Arial Black\", sans-serif",
    "size": "13.6px",
    "letter": "0.136px"
  },
