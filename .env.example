# Supabase — dipakai hanya di server (service role).
# Jangan pernah menambahkan prefix NEXT_PUBLIC_ pada service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email publik untuk tombol bantuan dan footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# URL publik yang dipakai metadata dan tautan absolut.
NEXT_PUBLIC_SITE_URL=https://suprizego.vercel.app
